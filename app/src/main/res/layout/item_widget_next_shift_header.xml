<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/headerCardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/shiftDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wednesday 6/17, 9:00am - 5:00pm"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shiftWorkstation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Role: Shift Lead"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/shiftManager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Manager: Alice Smith"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/coworkersHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scheduled Coworkers"
        android:textColor="@color/work_day_green"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
