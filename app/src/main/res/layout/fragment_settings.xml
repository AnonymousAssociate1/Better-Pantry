<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:clipChildren="false">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SETTINGS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:textColor="@color/work_day_green"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/hideAvailabilitySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Show Availability on Calendar"
            android:checked="true"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/combineShiftsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Combine Shifts in Detail View"
            android:checked="true"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTHENTICATION"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/work_day_green"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.ExposedDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/authFrequencyDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/myPayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pay Settings"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification Settings"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cafeSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cafe Settings"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUICK LINKS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:textColor="@color/work_day_green"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/workdayLearningButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Workday Learning"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/iBohButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iBOH"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/card_background_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/corcButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORC"
            android:textAlignment="viewStart"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_primary"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:drawableEnd="@drawable/ic_expand"
            android:drawableTint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="Log Out"
        android:textColor="@color/white"
        android:backgroundTint="@android:color/holo_red_dark"
        app:cornerRadius="20dp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
